# =============================================================================
# .aliases.local — aliases pessoais
# Carregado por ~/.zshrc.local, que é carregado pelo hook da imagem base
# Adicione aqui aliases que não fazem sentido para o time
# =============================================================================

# --- Editor pessoal ---
# Ajuste para o seu editor preferido
alias zshconfig='${EDITOR:-code} ~/.zshrc'
alias dotfiles='${EDITOR:-code} ~/.aliases.local'
alias cl=clear
alias http=httpyac
alias tree='eza --icons=always --color=always --group-directories-first --tree'
